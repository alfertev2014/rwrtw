{
  "name": "rwrtw-root",
  "private": true,
  "type": "module",
  "description": "The root project for RWRTW libraries, tools and examples",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w rwrtw && npm run build -w rwrtw-decl && npm run build -w rwrtw-demo",
    "ci": "npm run lint && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:alfertev2014/rwrtw.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
